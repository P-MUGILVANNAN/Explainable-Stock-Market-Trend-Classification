# ==============================================================================
# Stock Market Trend Classification System - Environment Template (.env.example)
# Copy this file to .env and configure values before starting the platform
# ==============================================================================

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=stock_trend_xai
USE_REAL_MONGO=0

# Security & Authentication (JWT)
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Financial News APIs (Optional - Yahoo Finance & GDELT are automated defaults)
NEWS_API_KEY=
FINNHUB_API_KEY=

# Machine Learning & Explainability
MODEL_STORAGE_PATH=backend/saved_models
FINBERT_MODEL_NAME=ProsusAI/finbert
DEVICE=cpu
LOAD_REMOTE_FINBERT=0

# Trend Target Classification Thresholds (±0.5% return)
UPWARD_THRESHOLD=0.005
DOWNWARD_THRESHOLD=-0.005
DEFAULT_HORIZON_DAYS=1

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","*"]

# Frontend Vite Configuration
VITE_API_URL=http://localhost:8000/api
