# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=stock_trend_xai

# Security & Authentication
JWT_SECRET=super-secret-stock-xai-key-change-in-production-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Financial News APIs (Optional - system automatically uses Yahoo Finance & GDELT if empty)
NEWS_API_KEY=
FINNHUB_API_KEY=

# Machine Learning & Explainability
MODEL_STORAGE_PATH=backend/saved_models
FINBERT_MODEL_NAME=ProsusAI/finbert
DEVICE=cpu

# Classification Thresholds
UPWARD_THRESHOLD=0.005
DOWNWARD_THRESHOLD=-0.005
DEFAULT_HORIZON_DAYS=1

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

